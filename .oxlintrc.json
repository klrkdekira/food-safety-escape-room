{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["src/player/**/*.ts", "src/player/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "zod", "message": "Zod is forbidden in the player runtime" },
              {
                "name": "immer",
                "message": "Immer is an author studio dependency, not a player one"
              }
            ],
            "patterns": [
              {
                "group": ["**/editor/**"],
                "message": "The player must not import from the editor studio"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/editor/**/*.tsx", "src/editor/**/*.ts"]
    }
  ],
  "ignorePatterns": [
    "docs/",
    "dist/",
    "node_modules/"
  ]
}
