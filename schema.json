{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Escape Room Data",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "pageTitle": { "type": "string" },
        "titleLogo": { "type": "string" },
        "titleSub": { "type": "string" },
        "minimapTitle": { "type": "string" },
        "minimapRooms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missionBriefingTitle": { "type": "string" },
        "missionBriefingText": { "type": "string" },
        "finalEscapeTerminalTitle": { "type": "string" },
        "finalEscapeTerminalText": { "type": "string" },
        "finalCode": { "type": "string" },
        "victoryTitle": { "type": "string" },
        "victorySubtitle": { "type": "string" },
        "victoryText": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["pageTitle", "titleLogo", "titleSub", "minimapTitle", "minimapRooms", "missionBriefingTitle", "missionBriefingText"]
    },
    "state": {
      "type": "object",
      "description": "Initial game state"
    },
    "puzzleData": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["order", "mcq", "multiselect", "match"] },
          "room": { "type": "integer" },
          "points": { "type": "integer" },
          "hint": { "type": "string" },
          "explanation": { "type": "string" },
          "title": { "type": "string" },
          "question": { "type": "string" },
          "options": {
            "type": "array",
            "description": "Used by mcq and multiselect types",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "text": { "type": "string" }
              },
              "required": ["key", "text"]
            }
          },
          "items": {
            "type": "array",
            "description": "Used by order type — items to drag into sequence",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" }
              },
              "required": ["id", "text"]
            }
          },
          "correctOrder": {
            "type": "array",
            "description": "Used by order type — correct sequence of item ids",
            "items": { "type": "string" }
          },
          "correct": {
            "description": "For mcq: string key. For multiselect: array of keys. For match: object mapping leftItem ids to rightItem ids.",
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } },
              { "type": "object", "additionalProperties": { "type": "string" } }
            ]
          },
          "leftItems": {
            "type": "array",
            "description": "Used by match type — left column items to be matched",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" }
              },
              "required": ["id", "text"]
            }
          },
          "rightItems": {
            "type": "array",
            "description": "Used by match type — right column options to match against",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" }
              },
              "required": ["id", "text"]
            }
          }
        },
        "required": ["type", "room", "points", "title", "question"]
      }
    },
    "roomCodes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "roomData": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "number": { "type": "string" },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "svg": { "type": "string" },
          "narrative": { "type": "string" },
          "codeHint": { "type": "string" }
        },
        "required": ["number", "title", "subtitle", "svg", "narrative"]
      }
    }
  },
  "required": ["config", "state", "puzzleData", "roomCodes", "roomData"]
}
