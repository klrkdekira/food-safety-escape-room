{
  "name": "food-safety-escape-room",
  "version": "1.0.0",
  "description": "Data-driven browser escape rooms for food science education.",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run validate && vite build",
    "preview": "vite preview --port 8000",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate.ts",
    "gen-schema": "tsx tools/gen-schema.ts",
    "test:schema": "tsx tools/test-schema.ts",
    "test:game": "tsx tools/test-game.ts",
    "test:accessibility": "tsx tools/test-accessibility.tsx",
    "test:route-recovery": "tsx tools/test-route-recovery.ts",
    "test:preview-contract": "tsx tools/test-preview-contract.ts",
    "test:e2e": "tsx tools/test-e2e.tsx",
    "test:playwright": "playwright test",
    "report:e2e": "playwright test && tsx tools/generate-e2e-report.ts",
    "lint": "oxlint",
    "fmt": "oxfmt src tools e2e",
    "fmt:check": "oxfmt --check src tools e2e",
    "html:check": "html-validate index.html",
    "test": "pnpm run validate && pnpm run test:schema && pnpm run test:game && pnpm run test:accessibility && pnpm run test:route-recovery && pnpm run test:preview-contract && pnpm run test:e2e && pnpm run test:playwright && tsx tools/generate-e2e-report.ts && pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run html:check",
    "fetch-fonts": "tsx tools/fetch-fonts.ts",
    "fetch-music": "tsx tools/fetch-music.ts"
  },
  "keywords": [
    "education",
    "food-safety",
    "escape-room"
  ],
  "author": "Chee Leong",
  "license": "MIT",
  "packageManager": "pnpm@11.15.0",
  "type": "module",
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "canvas-confetti": "^1.9.4",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.15",
    "lucide-animated": "^1.0.5",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "html-validate": "^11.6.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
